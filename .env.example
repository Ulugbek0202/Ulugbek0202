# ==============================================================================
# ENVIRONMENT VARIABLES
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE
# ------------------------------------------------------------------------------
# Public site URL. Used for canonical URLs, sitemap, robots.txt and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE (OPTIONAL)
# ------------------------------------------------------------------------------
# The site runs fully in DEMO MODE when these are empty: content is served from
# the local dataset in `src/data`, and the admin panel uses a local demo session
# that is ONLY enabled outside production (see src/lib/auth/*).
#
# To enable the real database, create a Supabase project, run the SQL in
# `supabase/migrations/`, then fill these in:
#
#   NEXT_PUBLIC_SUPABASE_URL        -> Project Settings > API > Project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY   -> Project Settings > API > anon public key
#   SUPABASE_SERVICE_ROLE_KEY       -> Project Settings > API > service_role key
#
# ⚠️  SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. It must ONLY ever be
#    used in server-side code (API routes / server actions). It is intentionally
#    NOT prefixed with NEXT_PUBLIC_ so it can never leak into the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. ADMIN DASHBOARD
# ------------------------------------------------------------------------------
# Demo-mode credentials for `/admin` when Supabase is not configured.
# In production these are ignored and Supabase Auth + RLS is enforced instead.
ADMIN_DEMO_EMAIL=admin@example.com
ADMIN_DEMO_PASSWORD=change-me-please

# Secret used to sign the demo admin session cookie (HMAC-SHA256).
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------------------
# 4. NOTIFICATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# Telegram notifications for new inquiries / applications.
# Create a bot with @BotFather, then get the chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Outbound email. Any SMTP-compatible provider (Resend, Postmark, SES, ...).
# When unset, submissions are persisted/logged and email is skipped gracefully.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Website <no-reply@example.com>"
NOTIFICATION_EMAIL=info@example.com

# ------------------------------------------------------------------------------
# 5. SPAM PROTECTION
# ------------------------------------------------------------------------------
# Comma-separated list of salted SHA-256 hashes allowed to skip spam checks
# (used only in development). Leave empty in production.
FORM_BYPASS_TOKENS=
